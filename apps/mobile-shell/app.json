{
  "expo": {
    "name": "Comma",
    "slug": "comma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "comma",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "cameraPermission": "휴식 활동 사진을 촬영할 수 있도록 카메라 접근 권한이 필요해요.",
          "photosPermission": "휴식 사진을 선택할 수 있도록 사진 보관함 접근 권한이 필요해요."
        }
      ],
      [
        "expo-media-library",
        {
          "granularPermissions": ["photo"],
          "photosPermission": "휴식 사진을 선택할 수 있도록 사진 보관함 접근 권한이 필요해요.",
          "savePhotosPermission": "휴식 사진을 저장할 수 있도록 사진 보관함 접근 권한이 필요해요."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#1a1814",
          "enableFullScreenImage_legacy": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": ["https://devrepo.kakao.com/nexus/content/groups/public/"]
          }
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.comma.app",
      "icon": "./assets/icon.png",
      "buildNumber": "20",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#303030"
      },
      "package": "app.comma.mobile",
      "versionCode": 14
    },
    "extra": {
      "apiBaseUrl": "https://167-126-10-48.sslip.io",
      "webUrl": "https://comma-front-web.vercel.app/",
      "eas": {
        "projectId": "6769c796-0c29-40a4-8afb-24f4e6df08de"
      }
    }
  }
}
