{
  "expo": {
    "name": "Comma",
    "slug": "comma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "comma",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-media-library",
        {
          "granularPermissions": ["photo"],
          "photosPermission": "휴식 사진을 선택할 수 있도록 사진 보관함 접근 권한이 필요해요."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#1a1814",
          "enableFullScreenImage_legacy": true
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.comma.app",
      "icon": "./assets/icon.png",
      "buildNumber": "16",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:comma-front-web.vercel.app",
        "webcredentials:comma-front-web.vercel.app"
      ]
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#303030"
      },
      "package": "app.comma.mobile",
      "versionCode": 13,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "comma-front-web.vercel.app",
              "path": "/oauth/google/callback"
            },
            {
              "scheme": "https",
              "host": "comma-front-web.vercel.app",
              "path": "/oauth/kakao/callback"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "extra": {
      "apiBaseUrl": "https://comma-production-9c37.up.railway.app",
      "webUrl": "https://comma-front-web.vercel.app/",
      "eas": {
        "projectId": "6769c796-0c29-40a4-8afb-24f4e6df08de"
      }
    }
  }
}
