{
  "name": "@comma/mobile-shell",
  "private": true,
  "version": "0.0.0",
  "main": "index.tsx",
  "scripts": {
    "dev": "expo start",
    "dev:device": "expo start --dev-client --lan",
    "android": "expo run:android",
    "android:development": "eas build --platform android --profile development",
    "android:preview": "eas build --platform android --profile preview",
    "ios": "expo run:ios",
    "ios:development": "eas build --platform ios --profile development",
    "web": "expo start --web",
    "android:build": "eas build --platform android --profile production",
    "android:submit": "eas submit --platform android --profile production",
    "ios:build": "eas build --platform ios --profile production",
    "ios:submit": "eas submit --platform ios --profile production",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@comma/bridge": "workspace:*",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-native-seoul/kakao-login": "^6.0.4",
    "@webview-bridge/react-native": "^1.7.9",
    "expo": "~54.0.37",
    "expo-apple-authentication": "~8.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.24",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-media-library": "~18.2.1",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "^3.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/react": "~19.1.17",
    "typescript": "~5.9.3"
  }
}
